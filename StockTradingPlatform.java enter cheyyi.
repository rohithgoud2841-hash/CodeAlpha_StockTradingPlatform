
import java.util.*;

class StockTradingPlatform {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double balance = 10000;
        int shares = 0;
        double stockPrice = 100;

        while (true) {
            System.out.println("\n=== STOCK TRADING PLATFORM ===");
            System.out.println("1. View Stock");
            System.out.println("2. Buy Shares");
            System.out.println("3. Sell Shares");
            System.out.println("4. View Portfolio");
            System.out.println("5. Exit");
            System.out.print("Choose option: ");

            int choice = sc.nextInt();

            switch (choice) {
                case 1:
                    System.out.println("Stock: ABC");
                    System.out.println("Price per share: Rs." + stockPrice);
                    break;

                case 2:
                    System.out.print("Enter shares to buy: ");
                    int buy = sc.nextInt();

                    if (buy > 0 && buy * stockPrice <= balance) {
                        balance -= buy * stockPrice;
                        shares += buy;
                        System.out.println("Shares bought successfully!");
                    } else {
                        System.out.println("Insufficient balance or invalid quantity.");
                    }
                    break;

                case 3:
                    System.out.print("Enter shares to sell: ");
                    int sell = sc.nextInt();

                    if (sell > 0 && sell <= shares) {
                        balance += sell * stockPrice;
                        shares -= sell;
                        System.out.println("Shares sold successfully!");
                    } else {
                        System.out.println("Invalid quantity!");
                    }
                    break;

                case 4:
                    System.out.println("Available balance: Rs." + balance);
                    System.out.println("Shares owned: " + shares);
                    System.out.println("Portfolio value: Rs."
                            + (balance + shares * stockPrice));
                    break;

                case 5:
                    System.out.println("Thank you for using the platform!");
                    sc.close();
                    return;

                default:
                    System.out.println("Invalid option. Try again.");
            }
        }
    }
}
